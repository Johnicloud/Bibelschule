# Optional: übergeordneter/externer Service, der alle Ereignisse der Dienste per POST bekommt
EXTERNAL_SERVICE_URL=
EXTERNAL_SERVICE_TOKEN=
# Zeitzone für das Leseprotokoll
TZ=Europe/Berlin
# Ollama für PDF-Vorlagen (KI-Vorschlag bei neuen Formularen). Läuft nicht in diesem Compose-Stack, sondern
# auf dem Mac selbst (eigenes Docker/Ollama.app) – von hier aus über host.docker.internal erreichbar, es sei
# denn Ollama läuft woanders: dann hier die passende Adresse eintragen.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
